# Template of the variables each environment needs.
# In CI the real files (.env.stage / .env.preprod / .env.prod) are restored here from the
# ENV_STAGE_BASE64 / ENV_PREPROD_BASE64 / ENV_PRODUCTION_BASE64 repository secrets (base64-encoded).
# This file also keeps the folder in git, so it exists on the runner after checkout.

APP_ENV=
API_BASE_URL=

# CleverTap
EXPO_PUBLIC_CLEVERTAP_ACCOUNT_ID=
EXPO_PUBLIC_CLEVERTAP_TOKEN=
EXPO_PUBLIC_CLEVERTAP_REGION=

# Firebase
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# MongoDB
MONGO_URI=
MONGO_DB_NAME=
